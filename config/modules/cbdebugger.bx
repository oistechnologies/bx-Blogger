/**
 * bx-Blogger - cbdebugger module configuration
 *
 * DEVELOPMENT ONLY. `enabled` must never be true in production.
 *
 * cbdebugger registers a LogBox TracerAppender on the ROOT logger
 * (ModuleConfig.afterConfigurationLoad, gated on `enabled &&
 * tracers.enabled`). Every log line then reaches
 * DebuggerService.pushTracer(), which does
 * `request.cbDebugger.tracers.append( arguments )` - it stores the whole
 * BoxLang arguments scope plus a DateTime, and nothing ever releases it.
 * On HTTP threads the request scope ends and the tracers go with it. On
 * the long-lived scheduler / cbq worker / async executor threads it does
 * NOT end, so those threads accumulate tracers for the life of the
 * container.
 *
 * Shipped to production this leaked ~500 MB/day. Both live sites reached
 * ~392,000 retained tracer objects (~75% of the live heap) inside 24h and
 * died with `OutOfMemoryError: Java heap space`, requiring a manual
 * container restart. `enabled: false` short-circuits both the appender
 * registration and onLoad()'s request/query collectors.
 *
 * THIS FILE MUST STAY TRACKED IN GIT. Until the fix, `config/modules/` was
 * caught by an unanchored `modules/` pattern in .gitignore, so this gate
 * existed only on developer laptops. CI builds from a clean clone, the file
 * was absent, and cbdebugger loaded with its OWN defaults - `enabled: true`
 * and `tracers.enabled: true`, precisely the pair that registers the
 * leaking appender. The gate everyone believed was protecting production
 * had never once run there.
 *
 * Second, independent guard: docker/Dockerfile builds the released image
 * with `box install --production`, so the module is not present at all in
 * production. Both guards are deliberate - either alone is sufficient.
 *
 * Fail-safe default is "production": an unset or misspelled ENVIRONMENT
 * leaves the debugger OFF. Matches the guard idiom in handlers/Main.bx.
 *
 * `.bx` + `class`, not `.cfc` + `component`, to match every other config
 * file in this flat BoxLang app. ColdBox's ModuleService globs
 * `config/modules` for "*.cfc|*.bx" and flags BoxLang by extension, so both
 * work; `.bx` keeps the tree consistent and leaves cfformat's component
 * pass with nothing to lint.
 */
class {

	function configure(){
		var isDev = lCase( trim( getSystemSetting( "ENVIRONMENT", "production" ) ) ) == "development";

		return {
			enabled          : isDev,
			debugMode        : isDev,
			debugPassword    : "cb",
			requestPanelDock : false,
			requestTracker   : {
				storage                      : "memory",
				cacheName                    : "template",
				trackDebuggerEvents          : false,
				expanded                     : false,
				slowExecutionThreshold       : 1000,
				maxProfilers                 : 50,
				profileWireBoxObjectCreation : false,
				profileObjects               : false,
				traceObjectResults           : false,
				profileInterceptions         : false,
				includedInterceptions        : [],
				executionTimers              : {
					expanded           : true,
					slowTimerThreshold : 250
				},
				coldboxInfo : { expanded : false },
				httpRequest : {
					expanded        : false,
					// Captures the raw request body into every retained
					// profiler. Off even in dev - it is pure heap cost.
					profileHTTPBody : false
				}
			},
			tracers     : { enabled : isDev, expanded : false },
			collections : {
				enabled      : true,
				expanded     : false,
				maxQueryRows : 50,
				maxDumpTop   : 5
			},
			cachebox : { enabled : true, expanded : false },
			modules  : { enabled : true, expanded : false },
			qb       : {
				enabled   : true,
				expanded  : false,
				logParams : true
			},
			cborm : {
				enabled   : true,
				expanded  : false,
				logParams : true
			},
			acfSql   : { enabled : false, expanded : false, logParams : true },
			luceeSQL : { enabled : false, expanded : false, logParams : true },
			async    : { enabled : true, expanded : false }
		};
	}

}
