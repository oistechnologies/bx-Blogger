/**
 * bx-Blogger — GaGtagEmissionSpec (Phase 15.K)
 *
 * Smoke checks for the gtag.js auto-emission block added to the
 * theme head-assets partials. Verifies:
 *
 *   - The block exists in all three core themes (default + magazine
 *     core; external opentag-dev theme lives in a separate repo so
 *     isn't asserted here).
 *   - Each block reads the right settings (ga.measurement_id,
 *     ga.emit_gtag, ga.consent_mode).
 *   - Each block guards on both `emit_gtag` AND the G-XXXX regex
 *     so a UA-style legacy ID can't render.
 *   - Each block embeds the Consent Mode v2 default-denied branch
 *     conditional on consent_mode = basic_eu or strict.
 *
 * Why not a live-HTTP render assertion: SettingService's CacheBox
 * cache lives in the live app's WireBox, distinct from the test
 * controller's WireBox. Test-side `set()` doesn't invalidate the
 * live cache, and fwreinit-as-a-bridge cascades into cbq worker
 * pool instability (workers hold stale application context after
 * the reinit and spam CBCONTROLLER KeyNotFoundException errors).
 * The live render path was verified manually via curl during the
 * Phase 15.K verification pass.
 */
class extends="tests.support.BaseIntegrationSpec" {

    function run() {
        describe( "Phase 15.K — gtag.js auto-emission", function() {

            for ( var themePath in [
                expandPath( "/themes/bx-blogger-default/partials/head-assets.bxm" ),
                expandPath( "/themes/bx-blogger-magazine/partials/head-assets.bxm" )
            ] ) {
                ( function( filePath ) {
                    var themeName = listLast( getDirectoryFromPath( arguments.filePath ), "/" );
                    if ( themeName == "partials" ) {
                        // getDirectoryFromPath includes a trailing /, peel off
                        // the partials/ to get the parent theme dir name.
                        var parts = listToArray( arguments.filePath, "/" );
                        themeName = parts[ parts.len() - 2 ];
                    }
                    describe( "in " & themeName, function() {

                        it( "head-assets file exists", function() {
                            expect( fileExists( filePath ) ).toBeTrue();
                        } );

                        it( "reads ga.measurement_id, ga.emit_gtag, ga.consent_mode from SettingService", function() {
                            var src = fileRead( filePath );
                            expect( src ).toInclude( "ga.measurement_id" );
                            expect( src ).toInclude( "ga.emit_gtag" );
                            expect( src ).toInclude( "ga.consent_mode" );
                            expect( src ).toInclude( "SettingService" );
                        } );

                        it( "guards on both emit_gtag AND the G-XXXX regex", function() {
                            var src = fileRead( filePath );
                            // Regex must be present (rejects UA-style IDs).
                            expect( src ).toInclude( "^G-[A-Z0-9]+$" );
                            // Verify the gtag-emit branch references both
                            // the emit flag and the regex check; we don't
                            // require a single bx:if literal (the regex
                            // was over-specified earlier) — just that the
                            // gating logic mentions both controls.
                            expect( src ).toInclude( "_gaEmitGtag" );
                            expect( src ).toInclude( "_gaMeasurementId" );
                        } );

                        it( "embeds the Consent Mode v2 default-denied branch conditional on basic_eu / strict", function() {
                            var src = fileRead( filePath );
                            expect( src ).toInclude( "ad_storage: 'denied'" );
                            expect( src ).toInclude( "analytics_storage: 'denied'" );
                            expect( src ).toInclude( "basic_eu" );
                            expect( src ).toInclude( "strict" );
                        } );

                        it( "emits the standard gtag init pair (gtag('js'...) + gtag('config'...))", function() {
                            var src = fileRead( filePath );
                            expect( src ).toInclude( "gtag('js'" );
                            expect( src ).toInclude( "gtag('config'" );
                            expect( src ).toInclude( "googletagmanager.com/gtag/js" );
                        } );

                    } );
                } )( themePath );
            }

        } );
    }

}
