/**
 * bx-Blogger — GaGtagEmissionSpec (Phase 15.K)
 *
 * Validates the gtag.js auto-emission added to the theme head-
 * assets partials. Tests the four conditional paths:
 *   1. measurement_id set + emit_gtag true  -> tag renders
 *   2. measurement_id empty                 -> no tag
 *   3. emit_gtag false                      -> no tag
 *   4. consent_mode = "basic_eu"            -> default-denied init block present
 *
 * Hits the live magazine theme via the running app's HTTP
 * endpoint so the test exercises the real render path.
 */
class extends="tests.support.BaseIntegrationSpec" {

    function beforeAll() {
        super.beforeAll();

        // Snapshot settings via raw SQL so we restore exact values.
        variables.savedSettings = {};
        for ( var k in [ "ga.measurement_id", "ga.emit_gtag", "ga.consent_mode" ] ) {
            var qry = queryExecute( "SELECT setting_value FROM settings WHERE setting_key = ?", [ k ] );
            variables.savedSettings[ k ] = qry.recordCount ? ( qry.setting_value ?: "" ) : "";
        }
    }

    function afterAll() {
        for ( var k in variables.savedSettings ) {
            writeSetting( k, variables.savedSettings[ k ] ?: "" );
        }
        bustCaches();
        super.afterAll();
    }

    /**
     * Set + persist via raw SQL (bypasses qb's empty-string-to-null
     * coercion AND SettingService cache scoping issues) so the live
     * app's render path sees the new value after bustCaches().
     */
    private void function writeSetting( required string key, required string value ) {
        var existing = queryExecute( "SELECT COUNT(*) AS n FROM settings WHERE setting_key = ?", [ arguments.key ] );
        if ( val( existing.n ) gt 0 ) {
            queryExecute(
                "UPDATE settings SET setting_value = ?, updated_at = ? WHERE setting_key = ?",
                [
                    { value : arguments.value,                                     cfsqltype : "cf_sql_varchar"   },
                    { value : dateTimeFormat( now(), "yyyy-mm-dd HH:nn:ss" ),      cfsqltype : "cf_sql_timestamp" },
                    { value : arguments.key,                                       cfsqltype : "cf_sql_varchar"   }
                ]
            );
        }
    }

    /**
     * fwreinit drops application + WireBox state so the next HTTP
     * request rebuilds SettingService from scratch and reads fresh
     * values from the DB. Slow (~200ms) but reliable across the
     * test-controller / live-app cache boundary.
     */
    private void function bustCaches() {
        var http = createObject( "java", "java.net.http.HttpClient" ).newBuilder().build();
        var req  = createObject( "java", "java.net.http.HttpRequest" ).newBuilder()
            .uri( createObject( "java", "java.net.URI" ).init( "http://localhost:8080/?fwreinit=1" ) )
            .timeout( createObject( "java", "java.time.Duration" ).ofSeconds( javaCast( "long", 10 ) ) )
            .GET()
            .build();
        var BodyHandlers = createObject( "java", "java.net.http.HttpResponse$BodyHandlers" );
        http.send( req, BodyHandlers.ofString() );
    }

    function run() {
        describe( "Phase 15.K — gtag.js auto-emission", function() {

            it( "emits the gtag <script> when measurement_id is set + emit_gtag is true", function() {
                writeSetting( "ga.measurement_id", "G-SPECTEST01" );
                writeSetting( "ga.emit_gtag",      "true"         );
                writeSetting( "ga.consent_mode",   "none"         );
                bustCaches();

                var html = fetchHome();
                expect( html ).toInclude( "googletagmanager.com/gtag/js?id=G-SPECTEST01" );
                expect( html ).toInclude( "gtag('js'" );
                expect( html ).toInclude( "G-SPECTEST01" );
                expect( html ).notToInclude( "ad_storage: 'denied'" );
            } );

            it( "does NOT emit the gtag when measurement_id is empty", function() {
                writeSetting( "ga.measurement_id", "" );
                writeSetting( "ga.emit_gtag",      "true" );
                bustCaches();

                var html = fetchHome();
                expect( html ).notToInclude( "googletagmanager.com/gtag/js" );
            } );

            it( "does NOT emit the gtag when emit_gtag is false", function() {
                writeSetting( "ga.measurement_id", "G-OFFTEST" );
                writeSetting( "ga.emit_gtag",      "false"     );
                bustCaches();

                var html = fetchHome();
                expect( html ).notToInclude( "googletagmanager.com/gtag/js" );
            } );

            it( "emits the Consent Mode v2 default-denied init block when consent_mode = basic_eu", function() {
                writeSetting( "ga.measurement_id", "G-EUTEST" );
                writeSetting( "ga.emit_gtag",      "true"     );
                writeSetting( "ga.consent_mode",   "basic_eu" );
                bustCaches();

                var html = fetchHome();
                expect( html ).toInclude( "googletagmanager.com/gtag/js?id=G-EUTEST" );
                expect( html ).toInclude( "ad_storage: 'denied'"        );
                expect( html ).toInclude( "analytics_storage: 'denied'" );
            } );

            it( "skips emission when measurement_id doesn't match the G-XXXX shape", function() {
                writeSetting( "ga.measurement_id", "UA-12345678-1" );
                writeSetting( "ga.emit_gtag",      "true"          );
                bustCaches();

                var html = fetchHome();
                expect( html ).notToInclude( "googletagmanager.com/gtag/js" );
            } );

        } );
    }

    private string function fetchHome() {
        // Hit the public home via the live MiniServer running the test
        // app — the wire test runner runs inside the same JVM but
        // crosses the HTTP boundary to exercise the real render path.
        var http = createObject( "java", "java.net.http.HttpClient" ).newBuilder().build();
        var req  = createObject( "java", "java.net.http.HttpRequest" ).newBuilder()
            .uri( createObject( "java", "java.net.URI" ).init( "http://localhost:8080/" ) )
            .timeout( createObject( "java", "java.time.Duration" ).ofSeconds( javaCast( "long", 10 ) ) )
            .GET()
            .build();
        var BodyHandlers = createObject( "java", "java.net.http.HttpResponse$BodyHandlers" );
        var res = http.send( req, BodyHandlers.ofString() );
        return res.body() ?: "";
    }

}
