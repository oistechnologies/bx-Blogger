<bx:script>
// @startWire
/**
 * analytics.geo — Phase 15.H Geography report.
 *
 * Two tabs: Countries / Cities. Country tab also shows a small
 * top-10 emoji bar list above the table.
 */

property name="gaService" inject="GoogleAnalyticsService";
property name="cbauth"    inject="AuthenticationService@cbauth";

data = {
    "canView"   : false,
    "connected" : false,
    "days"      : 7,
    "tab"       : "countries",
    "rows"      : [],
    "loading"   : false
};

function onMount( event, rc, prc, params ) {
    var u = cbauth.isLoggedIn() ? cbauth.getUser() : "";
    data.canView = !isSimpleValue( u ) && u.hasPermission( "ga.view" );
    if ( !data.canView ) return;
    hydrate();
}

function setRange( numeric days ) {
    if ( !data.canView ) return;
    data.days = max( 1, int( arguments.days ) );
    hydrate();
}

function setTab( required string tab ) {
    if ( !data.canView ) return;
    data.tab = arguments.tab;
    hydrate();
}

function refresh() {
    if ( !data.canView ) return;
    try { gaService.invalidateCaches(); } catch ( any e ) {}
    hydrate();
}

private void function hydrate() {
    data.loading   = true;
    data.connected = isGaConnected();
    if ( !data.connected ) {
        data.rows    = [];
        data.loading = false;
        return;
    }
    try {
        data.rows = data.tab == "cities"
            ? gaService.topCities( days = data.days, n = 50 )
            : gaService.topCountries( days = data.days, n = 50 );
    }
    catch ( any e ) { data.rows = []; }
    data.loading = false;
}

private boolean function isGaConnected() {
    try { return gaService.status().connected; }
    catch ( any e ) { return false; }
}
// @endWire
</bx:script>

<bx:output>
<div>

<bx:if !args.canView>
    <div class="alert alert-warning"><i class="bi bi-shield-lock me-1"></i> You don't have permission to view Analytics.</div>
<bx:elseif !args.connected>
    <div class="card stat-card stat-card-secondary"><div class="card-body text-center p-5">
        <h4>Google Analytics is not connected</h4>
        <a class="btn btn-primary" href="/admin/settings/ga"><i class="bi bi-link-45deg me-1"></i> Connect Google Analytics</a>
    </div></div>
<bx:else>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="btn-group btn-group-sm">
            <button class="btn #( args.days == 7  ? "btn-primary" : "btn-outline-primary" )#" wire:click="setRange(7)" >Last 7d</button>
            <button class="btn #( args.days == 28 ? "btn-primary" : "btn-outline-primary" )#" wire:click="setRange(28)">Last 28d</button>
            <button class="btn #( args.days == 90 ? "btn-primary" : "btn-outline-primary" )#" wire:click="setRange(90)">Last 90d</button>
        </div>
        <button class="btn btn-sm btn-outline-secondary" wire:click="refresh"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link #( args.tab == "countries" ? "active" : "" )#" wire:click="setTab('countries')">Countries</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link #( args.tab == "cities"    ? "active" : "" )#" wire:click="setTab('cities')">Cities</button>
        </li>
    </ul>

    <div class="card stat-card stat-card-info">
        <div class="card-body p-0">
            <bx:if !args.rows.len()>
                <p class="text-muted small m-3 mb-0">No data for this window / tab yet.</p>
            <bx:else>
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><bx:if args.tab == "countries">Country<bx:else>City</bx:if></th>
                            <th class="text-end">Active users</th>
                            <th class="text-end">Sessions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <bx:loop array="#args.rows#" item="r">
                            <tr>
                                <td class="small">#encodeForHTML( len( r.label ?: "" ) ? r.label : "(not set)" )#</td>
                                <td class="text-end small">#numberFormat( int( r.activeUsers ?: 0 ) )#</td>
                                <td class="text-end small">#numberFormat( int( r.sessions    ?: 0 ) )#</td>
                            </tr>
                        </bx:loop>
                    </tbody>
                </table>
            </bx:if>
        </div>
    </div>
</bx:if>
</div>
</bx:output>
