# Version control
.git
.gitignore
.gitattributes

# Claude Code — AI-session instructions, not runtime artifacts
.claude
CLAUDE.md

# Internal planning docs — already gitignored, doubly-protected here
DEV-NOTES

# Node artifacts
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Build outputs (regenerated inside the Dockerfile theme-builder stage)
themes/*/assets
dist
build

# Test suite + artifacts.
#
# `tests/` is excluded from the IMAGE deliberately. In the flat layout the
# project root IS the web root, so a shipped `tests/runner.bxm` is a real file
# at `/tests/runner.bxm` that runs the whole integration suite on a plain GET —
# against whatever database the container is pointed at. Nothing in the running
# app needs `tests/`.
#
# Dev and CI are unaffected: docker-compose.yml bind-mounts `./:/app`, so the
# dev container gets tests/ from the host checkout, not from the image.
tests
coverage

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode
.idea
*.swp
*.swo

# Env files — secrets must never enter the image
.env
.env.local
.env.*.local

# Ops runbooks and local notes
*.md.local
scratch

# Docker's own
.dockerignore
Dockerfile
docker-compose*.yml
